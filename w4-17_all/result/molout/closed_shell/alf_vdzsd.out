#INFO: **** input file is /home/sharmagroup/sharmagroup/w4_17/w4-17_all/pyscf_input/run_pyscf_vdzsd.py ****
import os
import glob
import argparse
import numpy as np
from pyscf import gto, scf, cc


def parse_index_range(spec):
    """Parse index spec like '1-10', '5', or '1,3,5-8' into a set of 1-based ints."""
    indices = set()
    for part in spec.split(','):
        part = part.strip()
        if '-' in part:
            lo, hi = part.split('-', 1)
            indices.update(range(int(lo), int(hi) + 1))
        else:
            indices.add(int(part))
    return indices


parser = argparse.ArgumentParser(description="Run HF/CCSD/CCSD(T) for W4-17 molecules.")
parser.add_argument('--shell', choices=['closed', 'open'], default='open',
                    help='Which shell type to run (default: open)')
parser.add_argument('--index', default=None,
                    help='Molecule index range to run, 1-based sorted order. '
                         'Examples: 1-10  |  5  |  1,3,5-8  (default: all)')
parser.add_argument('--symmetry', action='store_true', default=False,
                    help='Enable point-group symmetry (default: off)')
args = parser.parse_args()

shell     = args.shell
symmetry  = args.symmetry
xyz_dir      = f"../w4_17_xyz/{shell}_shell"
results_file = f"../result/{shell}_shell_uhf_vdzsd.dat"
out_dir      = f"../result/molout/{shell}_shell"
os.makedirs(out_dir, exist_ok=True)

# Optional name-based filter (unchanged from original)
select_molecules = None

def vdzsd(elem):
    if elem in ('H', 'He'):
        raw_basis = gto.basis.load('ccpvdz', elem)
        return [b for b in raw_basis if b[0] != 1]
    else:
        return gto.basis.load('ccpvdz', elem)

def get_vdzsd_basis(atoms):
    elems = {line.split()[0] for line in atoms.strip().splitlines() if line.strip()}
    basis_dict = {el: vdzsd(el) for el in elems}
    return basis_dict

all_xyz = sorted(glob.glob(os.path.join(xyz_dir, "*.xyz")))

# Apply name-based filter first
if select_molecules is not None:
    select_set = set(select_molecules)
    all_xyz = [p for p in all_xyz if os.path.splitext(os.path.basename(p))[0] in select_set]
    missing = select_set - {os.path.splitext(os.path.basename(p))[0] for p in all_xyz}
    if missing:
        print(f"Warning: no .xyz file found for: {', '.join(sorted(missing))} in {xyz_dir}")

# Apply index filter (1-based)
if args.index is not None:
    wanted = parse_index_range(args.index)
    out_of_range = [i for i in wanted if i < 1 or i > len(all_xyz)]
    if out_of_range:
        print(f"Warning: indices out of range (1–{len(all_xyz)}): {sorted(out_of_range)}")
    all_xyz = [all_xyz[i - 1] for i in sorted(wanted) if 1 <= i <= len(all_xyz)]

xyz_files = all_xyz
print(f"Shell: {shell}  |  Molecules to run: {len(xyz_files)}")
for i, p in enumerate(xyz_files, 1):
    print(f"  {i:3d}. {os.path.basename(p)}")

with open(results_file, "w") as out:
    out.write(f"{'Molecule':<16s} {'Charge':>6s} {'2S':>6s} {'frozen':>6s} "
              f"{'E_HF (Eh)':>20s} {'E_CCSD (Eh)':>20s} {'E_CCSD(T) (Eh)':>20s}\n")
    out.write("-" * 100 + "\n")

for xyz_path in xyz_files:
    with open(xyz_path, "r") as f:
        lines = f.readlines()

    # Parse charge and multiplicity from second line: "name charge=X mult=Y"
    second_line = lines[1]
    charge = int(second_line.split("charge=")[1].split()[0])
    mult   = int(second_line.split("mult=")[1].split()[0])
    spin   = mult - 1   # PySCF spin input is 2S = mult - 1
    mol_name = second_line.split()[0]

    # Coordinates only (skip the atom count and comment lines)
    atoms = "".join(lines[2:])
    basis_dict = get_vdzsd_basis(atoms)

    print(f"\n{'='*60}")
    print(f"Running: {mol_name}  charge={charge}  spin={spin}")
    print(f"{'='*60}")
    
    mol = gto.M(
        atom=atoms,
        basis=basis_dict,
        verbose=4,
        output=os.path.join(out_dir, f"{mol_name}_vdzsd.out"),
        unit="angstrom",
        symmetry=symmetry,
        charge=charge,
        spin=spin,
        max_memory=40000,
    )

    mf = scf.UHF(mol)
    mf.max_cycle = 200
    mf = mf.newton()
    mf.kernel()

    # Stability check loop — at most 10 attempts
    max_stability_cycles = 10
    stable = False
    for stability_iter in range(max_stability_cycles):
        mo_i, _, stable, _ = mf.stability(return_status=True)
        if stable:
            break
        dm = mf.make_rdm1(mo_i, mf.mo_occ)
        mf.kernel(dm0=dm)

    if not stable or not mf.converged:
        print(f"  !! SCF did not converge for {mol_name} — skipping.")
        with open(results_file, "a") as out:
            out.write(f"{mol_name:<16s} {charge:>6d} {spin:>6d} {'N/A':>6s} "
                      f"{'UNCONVERGED':>20s} {'UNCONVERGED':>20s} {'UNCONVERGED':>20s}\n")
        continue

    energy = mf.e_tot

    mycc = cc.CCSD(mf)
    mycc.set_frozen()
    mycc.kernel()
    e_ccsd = mycc.e_tot
    et = mycc.ccsd_t()
    e_ccsdt = e_ccsd + et
    frozen = mycc.frozen

    with open(results_file, "a") as out:
        out.write(f"{mol_name:<16s} {charge:>6d} {spin:>6d} {frozen:>6d} "
                  f"{energy:>20.10f} {e_ccsd:>20.10f} {e_ccsdt:>20.10f}\n")

    print(f"  => E_HF({mol_name})     = {energy:.10f} Eh")
    print(f"  => E_CCSD({mol_name})    = {e_ccsd:.10f} Eh")
    print(f"  => E_CCSD(T)({mol_name}) = {e_ccsdt:.10f} Eh")

print(f"\nAll calculations complete. Results saved to {results_file}")
#INFO: ******************** input file end ********************


